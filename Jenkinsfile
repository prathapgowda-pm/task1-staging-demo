    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout completed'
            }
        }
        stage('Build') {
            steps {
                echo 'Build successful'
            }
        }
        stage('Test') {
            steps {
                echo 'Tests passed'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deployment completed'
            }
        }
    }
}

